# LEO CONNECT — ortam değişkenleri örneği
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env commit EDİLMEZ.

# --- ZORUNLU ---
# PostgreSQL bağlantı dizesi. Tanımlı değilse sunucu açılmaz.
DATABASE_URL=postgres://kullanici:sifre@host:5432/veritabani

# JWT imzalama anahtarı. Uzun ve rastgele olmalı.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- ADMIN GİRİŞİ ---
# İkisi de boşsa /api/admin/login 503 döner.
ADMIN_EMAIL=admin@ornek.com
ADMIN_PASSWORD=

# --- OPSİYONEL ---
# QR ve NFC bağlantılarının mutlak adresi. Render'da RENDER_EXTERNAL_URL otomatik gelir.
PUBLIC_URL=http://localhost:10000

# Dinlenecek port (Render kendi değerini enjekte eder).
PORT=10000

# production ise PostgreSQL SSL açılır.
NODE_ENV=development
